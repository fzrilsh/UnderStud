# Backend configuration — ALL values have defaults; nothing here is required.
# (kecuali: GEO_FENCE_ENABLED=true mewajibkan SCHOOL_LAT + SCHOOL_LNG)

# Server
PORT=8080
LOG_LEVEL=info
TZ=Asia/Jakarta

# Database
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/hackathon?sslmode=disable
DB_MAX_CONNS=10
DB_MIN_CONNS=2

# Auth
# JWT_SECRET=            # WAJIB di produksi (min 32 byte). Kosong = generate acak saat start.
STAFF_TOKEN_TTL=168h
ANON_TOKEN_TTL=87600h
COOKIE_SECURE=false

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Geofence (OFF by default; aktifkan + set koordinat bila perlu)
GEO_FENCE_ENABLED=false
SCHOOL_LAT=
SCHOOL_LNG=
SCHOOL_RADIUS_M=200

# AI (OpenAI-compatible)
AI_BASE_URL=http://localhost:11434/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_DEBOUNCE_SECONDS=5

# Upload (batas per-file = 10 MB, konstanta internal; tak ada env terpisah)
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_TOTAL_MB=20

# Rate limit (per sesi anonim; *PerHour=0 memblokir fitur → jangan di-set 0)
RATE_LIMIT_CHATS_PER_HOUR=10
RATE_LIMIT_MESSAGES_PER_HOUR=30
RATE_LIMIT_SESSIONS_PER_HOUR=60
RATE_LIMIT_IP_MULTIPLIER=20
