# Backend configuration — ALL values have defaults; nothing here is required.
# For docker-compose usage these are already set in docker-compose.yml.
# For local dev (make dev / make run) either export overrides or rely on defaults.

# Server
PORT=8080
LOG_LEVEL=info

# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/hackathon?sslmode=disable
DB_MAX_CONNS=10
DB_MIN_CONNS=2

# Auth — JWT HS256. TTL 87600h = 10 years (long-lived cookie, no refresh token).
JWT_SECRET=dev-secret-change-me-in-prod
AUTH_TOKEN_TTL=87600h

# CORS — comma-separated origins allowed to call the API with credentials.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
