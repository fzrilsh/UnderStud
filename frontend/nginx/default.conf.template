server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # SPA fallback
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Proxy API.
    # Upstream dikonfigurasi lewat env API_UPSTREAM (lihat Dockerfile untuk default):
    # - monorepo root compose  : http://api:8080        (service name, 1 network)
    # - standalone frontend    : http://host.docker.internal:8080 (backend di host)
    location /api/ {
        proxy_pass ${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
