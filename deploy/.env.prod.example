# ============================================================================
# Understud: konfigurasi PRODUKSI untuk server (shared infra).
#
# Cara pakai di server:
#   mkdir -p ~/services/understud
#   cp deploy/.env.prod.example ~/services/understud/.env
#   nano ~/services/understud/.env      # isi nilainya
#   chmod 600 ~/services/understud/.env # jangan sampai terbaca user lain
#
# File ini JANGAN di-commit ke repo.
# ============================================================================

# --- WAJIB: database (Postgres + pgbouncer milikmu) --------------------------

# Migrasi goose butuh sesi yang stabil, sedangkan pgbouncer mode transaction
# tidak menjaminnya. Karena itu:
#   - `MIGRATE_ON_START=false`  -> app tidak menjalankan migrasi saat start
#   - jalankan migrasi manual lewat `cli migrate` ke postgres:5432 (bukan pgbouncer)
#
# Connection string lewat PGBOUNCER, dengan simple protocol (wajib untuk
# pgbouncer mode transaction):
#   postgres://USER:PASSWORD@pgbouncer:6432/understud?sslmode=disable&default_query_exec_mode=simple_protocol
#
# Perhatikan: password harus URL-encoded kalau mengandung karakter khusus
# (@ : / ? # & = spasi).
DATABASE_URL=postgres://understud:GANTI_PASSWORD@pgbouncer:6432/understud?sslmode=disable&default_query_exec_mode=simple_protocol

# Matikan migrasi otomatis (lihat penjelasan di atas).
MIGRATE_ON_START=false

# Pool kecil: pgbouncer sudah yang mengurus pooling.
DB_MAX_CONNS=5
DB_MIN_CONNS=0

# --- WAJIB: keamanan ---------------------------------------------------------

# Secret JWT sesi staf. Minimal 32 karakter.
# Bikin: openssl rand -hex 32
JWT_SECRET=GANTI_DENGAN_OPENSSL_RAND_HEX_32

# Domain publik (dipakai backend untuk daftar CORS).
CORS_ORIGINS=https://understud.fazrilsh.com

# Pengguna mengakses lewat HTTPS (Cloudflare), jadi cookie wajib Secure.
COOKIE_SECURE=true

# Di belakang Cloudflare Tunnel: percayai X-Real-IP / X-Forwarded-For.
TRUST_PROXY_HEADERS=true

# --- Aplikasi ----------------------------------------------------------------

PORT=8080
TZ=Asia/Jakarta
LOG_LEVEL=info
STAFF_TOKEN_TTL=168h
ANON_TOKEN_TTL=87600h

# Lampiran disimpan di dalam container (mount volume kalau mau persisten
# lintas recreate; lihat catatan di README).
UPLOAD_DIR=/app/data/uploads
MAX_UPLOAD_TOTAL_MB=20

# Rate limit
RATE_LIMIT_CHATS_PER_HOUR=10
RATE_LIMIT_MESSAGES_PER_HOUR=30
RATE_LIMIT_SESSIONS_PER_HOUR=60
RATE_LIMIT_IP_MULTIPLIER=20

# --- AI (OpenAI-compatible, opsional) ----------------------------------------
# Kosong = fitur ringkasan AI nonaktif (aplikasi tetap jalan normal).
# Karena api dan provider AI beda container, jangan pakai `localhost`.
# Isi URL lengkap provider (contoh: gateway lokal di host -> host.docker.internal,
# atau endpoint publik).
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_DEBOUNCE_SECONDS=5

# --- Geofence (opsional) -----------------------------------------------------
# Kalau GEO_FENCE_ENABLED=true, SCHOOL_LAT & SCHOOL_LNG WAJIB diisi.
GEO_FENCE_ENABLED=false
SCHOOL_LAT=
SCHOOL_LNG=
SCHOOL_RADIUS_M=200
