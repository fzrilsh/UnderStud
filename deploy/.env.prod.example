# ============================================================================
# UnderStud: konfigurasi PRODUKSI (server/VPS).
#
# Cara pakai:
#   cp deploy/.env.prod.example .env.prod     lalu isi nilainya.
#   docker-compose --env-file .env.prod -f docker-compose.prod.yml up -d
#
# File `.env.prod` JANGAN di-commit (sudah di-ignore git).
# ============================================================================

# --- WAJIB diisi -------------------------------------------------------------

# Secret JWT untuk sesi staf. Minimal 32 karakter.
# Bikin yang acak:  openssl rand -hex 32
JWT_SECRET=ganti-dengan-hasil-openssl-rand-hex-32

# Password database. Bikin yang acak juga.
POSTGRES_PASSWORD=ganti-password-database-yang-kuat

# --- Domain & keamanan -------------------------------------------------------

# Domain publik. Dipakai backend untuk daftar CORS.
CORS_ORIGINS=https://understud.fazrilsh.com

# Wajib `true` kalau diakses lewat HTTPS (Cloudflare sudah HTTPS, jadi true).
COOKIE_SECURE=true

# Percayai X-Real-IP / X-Forwarded-For dari proxy di depan (Cloudflare / nginx host).
TRUST_PROXY_HEADERS=true

# --- Port di server ----------------------------------------------------------

# Hanya didengarkan di localhost. Reverse proxy host yang meneruskan ke sini.
# Kalau pakai Cloudflare Tunnel, arahkan tunnel ke http://localhost:3000.
WEB_PORT=3000
BIND_ADDR=127.0.0.1

# --- Image GHCR --------------------------------------------------------------

# Pemilik paket di GHCR (username/org GitHub). Default sudah diisi.
GHCR_OWNER=fzrilsh
# Tag image: `latest` (ikut main) atau `sha-xxxxxxx` (versi tertentu, lebih aman).
IMAGE_TAG=latest

# --- Database ----------------------------------------------------------------

POSTGRES_USER=postgres
POSTGRES_DB=understud

# --- Opsional (semua punya default) ------------------------------------------

TZ=Asia/Jakarta
LOG_LEVEL=info
STAFF_TOKEN_TTL=168h
ANON_TOKEN_TTL=87600h
MAX_UPLOAD_TOTAL_MB=20
DB_MAX_CONNS=10
DB_MIN_CONNS=2
RATE_LIMIT_CHATS_PER_HOUR=10
RATE_LIMIT_MESSAGES_PER_HOUR=30
RATE_LIMIT_SESSIONS_PER_HOUR=60
RATE_LIMIT_IP_MULTIPLIER=20

# --- AI (OpenAI-compatible) --------------------------------------------------
# Kosong = fitur ringkasan AI nonaktif (aplikasi tetap jalan normal).
# Catatan: kalau provider AI jalan di mesin lain, isi URL lengkapnya di sini.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_DEBOUNCE_SECONDS=5

# --- Geofence (opsional) -----------------------------------------------------
# Kalau GEO_FENCE_ENABLED=true, SCHOOL_LAT & SCHOOL_LNG WAJIB diisi,
# kalau tidak server menolak start.
GEO_FENCE_ENABLED=false
SCHOOL_LAT=
SCHOOL_LNG=
SCHOOL_RADIUS_M=200
