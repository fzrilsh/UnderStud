# ============================================================================
# Understud — konfigurasi stack penuh (docker-compose) + dev backend.
#
# Cara pakai:
#   cp .env.example .env      lalu isi nilainya.
#   docker-compose up -d      (compose otomatis membaca file `.env` ini)
#
# Semua nilai PUNYA DEFAULT — file ini opsional. Yang kosong = pakai default.
# Khusus AI: kosongkan AI_API_KEY untuk menonaktifkan ringkasan AI
# (backend tetap jalan normal; endpoint ringkasan balas AI_NOT_CONFIGURED).
# ============================================================================

# --- AI (OpenAI-compatible) --------------------------------------------------
# Cukup isi 3 baris ini. Base URL HARUS mengarah ke root API yang punya
# endpoint `/chat/completions` (format OpenAI). Contoh:
#   OpenAI     : https://api.openai.com/v1
#   Groq       : https://api.groq.com/openai/v1
#   OpenRouter : https://openrouter.ai/api/v1
#   Together   : https://api.together.xyz/v1
#   Ollama     : http://localhost:11434/v1
#   LM Studio  : http://localhost:1234/v1
#
# Untuk provider yang jalan di HOST (mis. Ollama/LM Studio/gateway lokal),
# cukup tulis `localhost` — backend otomatis menerjemahkan ke
# host.docker.internal saat jalan di container, dan tetap localhost saat
# `go run` di host. Satu .env untuk dua lingkungan.
AI_BASE_URL=http://localhost:11434/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_DEBOUNCE_SECONDS=5

# --- Geofence (default OFF) --------------------------------------------------
# Aktifkan (true) WAJIB mengisi SCHOOL_LAT + SCHOOL_LNG, kalau tidak server
# menolak start. Cek radius lewat `make check-location lat=.. lng=.. radius=..`.
GEO_FENCE_ENABLED=false
SCHOOL_LAT=
SCHOOL_LNG=
SCHOOL_RADIUS_M=200

# --- Opsional lain (semua punya default) -------------------------------------
# JWT_SECRET=              # produksi: min 32 byte. Kosong = generate acak saat start.
# COOKIE_SECURE=false      # true bila di belakang HTTPS.
# API_PORT=8080            # override port API bila bentrok.
# WEB_PORT=3000            # override port web bila bentrok.
# DB_PORT=5433             # override port host Postgres.
